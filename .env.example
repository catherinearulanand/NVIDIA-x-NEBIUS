# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Exact NVIDIA model ID from your Token Factory catalog (run `npm run preflight` to list them).
NEBIUS_MODEL_ID=
# Optional extra JSON merged into each request body, e.g. model-specific options.
NEBIUS_EXTRA_BODY=
NEBIUS_MAX_TOKENS=2000

# local = single vault on 127.0.0.1; hosted = per-browser synthetic demo sessions
MINDVAULT_PROFILE=local
MINDVAULT_TIMEZONE=Asia/Kolkata
PORT=8787
